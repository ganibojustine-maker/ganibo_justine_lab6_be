# Copy this file to .env and update the values below (NEVER commit .env)

# Application Settings
APP_NAME=ProductManagementAPI
APP_KEY=
APP_ENV=development

# Database Configuration (Aiven MySQL -> Console > your service > Overview)
DB_DRIVER=mysql
DB_HOST=your-service-name.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_CHARSET=utf8mb4
DB_PREFIX=
# Aiven requires TLS. Optional: put Aiven's ca.pem in the project root (same folder as this file)
DB_SSL=true
# DB_SSL_CA=/var/www/html/ca.pem

# For API (generate with: php lava jwt:generate --show)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# CORS: comma-separated list of allowed frontend origins ("*" = allow all, dev only)
CORS_ORIGIN=http://localhost:5173

# Migrations
MIGRATION_ENABLED=true
# Browser migration routes (/migrate, /rollback ...) are DISABLED unless this is "true".
# Keep it false on Render. The CLI (php lava migration run) always works.
ALLOW_WEB_MIGRATION=false
